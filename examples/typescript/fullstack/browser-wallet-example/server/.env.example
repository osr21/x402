# Wallet address to receive payments
  ADDRESS=0xYourWalletAddressHere

  # x402 facilitator URL
  # Testnet (Base Sepolia): https://x402.org/facilitator  (default)
  # Mainnet (Base):         https://api.cdp.coinbase.com/platform/v2/x402
  FACILITATOR_URL=https://x402.org/facilitator

  # Network — must be compatible with FACILITATOR_URL above
  NETWORK=base-sepolia

  # Port the server listens on
  PORT=3001

  # CORS allowed origins (comma-separated). Set this to your frontend URL in production.
  # Default (dev): http://localhost:5173,http://localhost:3000
  CORS_ORIGIN=http://localhost:5173
  